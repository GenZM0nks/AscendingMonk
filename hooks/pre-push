#!/bin/bash

export GOPATH="$HOME/go"
export GOBIN="$GOPATH/bin"
export PATH="$HOME/.local/bin:$HOME/bin:$GOBIN:/usr/local/bin:$PATH"

revive -set_exit_status ./...
lint_status=$?

if [ "$lint_status" -ne 0 ]; then
    echo "Linting failed. Push rejected."
    exit "$lint_status"
fi

superlint_msg=$(./scripts/superlint.sh)
superlint_status=$?

if [ "$superlint_status" -ne 0 ]; then
    if [ "$superlint_status" -eq 2 ]; then
        echo "Super linting failed. push rejected."
    else
        echo "Super linting script failed. push rejected."
    fi
    echo "$superlint_msg"
    exit "$superlint_status"
fi

go test ./test
test_status=$?

if [ "$test_status" -ne 0 ]; then
    echo "Test(s) failed. Push rejected."
    exit "$test_status"
fi

exit 0